# Public EC2 deployment only. Native development does not need this file.
# Copy to .env, then replace all three placeholders before starting Compose.
# Use your lowercase public DNS hostname, without https://, a path or a port.
DOMAIN=your-domain.example

# Choose a username using letters, numbers, underscores, dots or dashes.
BASIC_AUTH_USER=replace-me

# Generate with: docker run --rm -it caddy:2.10.2-alpine caddy hash-password
# Paste the complete bcrypt hash between the single quotes to preserve $ signs.
BASIC_AUTH_HASH='replace-me-with-generated-bcrypt-hash'

# Keep this default when following the model-download commands in the guide.
# This host directory is mounted read-only at /models in the application.
TABLEWATCH_MODEL_HOST_DIR=./models
