{
  "name": "tablewatch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:full": "node scripts/dev-full.mjs",
    "service": ".venv/bin/python -m service",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:stateless-browser": "playwright test --config playwright.stateless.config.ts",
    "check:repo": ".venv/bin/python scripts/check_repository.py",
    "replay": "node --import tsx web/src/headless.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.56.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
